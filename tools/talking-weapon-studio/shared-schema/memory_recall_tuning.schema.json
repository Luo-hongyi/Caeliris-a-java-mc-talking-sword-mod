{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamdust.local/talking-weapon-studio/memory_recall_tuning.schema.json",
  "title": "Talking Weapon Memory Recall Tuning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "mainCandidatesPerCue",
    "sandboxCuesPerMemory",
    "consciousMemoryCap",
    "retentionMemoryCap",
    "recentRecallWindow",
    "recentRecallWindowCap",
    "implantedFallbackEntryScore",
    "promptFillProbabilityScale",
    "tagPoolHalfLifeDays",
    "tagPoolDecayShape",
    "tagPoolDropThreshold",
    "tagPoolReheatPulseGain",
    "tagPoolReheatDecayPerHit",
    "tagPoolReheatFloor",
    "fermentationHalfLifeDays",
    "fermentationDecayShape",
    "fermentationDropThreshold",
    "intervalBonusScale",
    "intervalBonusSteepness",
    "synthesizedMemoryHalfLife",
    "desireProfileBonusScale",
    "desiredFocusBonusScale"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 4
    },
    "generatedAt": {
      "type": "string"
    },
    "mainCandidatesPerCue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "sandboxCuesPerMemory": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "consciousMemoryCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "retentionMemoryCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "recentRecallWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "recentRecallWindowCap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "implantedFallbackEntryScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "promptFillProbabilityScale": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "tagPoolHalfLifeDays": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1
    },
    "tagPoolDecayShape": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "tagPoolDropThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.2
    },
    "tagPoolReheatPulseGain": {
      "type": "number",
      "minimum": 1,
      "maximum": 3
    },
    "tagPoolReheatDecayPerHit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tagPoolReheatFloor": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 1
    },
    "fermentationHalfLifeDays": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 2
    },
    "fermentationDecayShape": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "fermentationDropThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.2
    },
    "intervalBonusScale": {
      "type": "number",
      "minimum": 0,
      "maximum": 2.5
    },
    "intervalBonusSteepness": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 8
    },
    "synthesizedMemoryHalfLife": {
      "type": "number",
      "minimum": 1,
      "maximum": 240
    },
    "desireProfileBonusScale": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "desiredFocusBonusScale": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  }
}
